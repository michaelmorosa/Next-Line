# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DEBUG=True
HOST=localhost,127.0.0.1,10.0.2.2,192.168.1.50

DATABASE_NAME=nextline_db
DATABASE_USER=nextline
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Optional: email (activation / password reset). Without these, emails print to the console.
# MAILGUN_SMTP_USER=
# MAILGUN_SMTP_PASSWORD=
# SEND_ACTIVATION_EMAIL=False

# Optional: crash alert texts. Without these, alerts are saved and logged but not sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15555550123
